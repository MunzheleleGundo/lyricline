rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Anyone can read/stream audio and cover art (needed for playback).
    // Only a signed-in user can upload into their own uploads/{uid}/ folder,
    // and files are capped at 25MB to keep the free tier sane.
    match /uploads/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
