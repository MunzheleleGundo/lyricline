# Copy this file to .env.local and fill in real values when you're ready
# to wire up real streaming connections. Vite only exposes variables
# prefixed with VITE_ to client-side code.

# Spotify: create an app at https://developer.spotify.com/dashboard
# Use Authorization Code + PKCE flow — this can run entirely client-side,
# no client secret required.
VITE_SPOTIFY_CLIENT_ID=

# Apple Music: requires MusicKit JS + a developer token. The token must be
# a JWT signed server-side with your Apple Developer private key — this
# cannot be generated purely in the browser, so you'll need a small backend
# (or serverless function) even for a minimal integration.
VITE_APPLE_MUSIC_DEVELOPER_TOKEN=

# YouTube Music has no official public API for personal libraries.
# Left as a placeholder for later.
VITE_YOUTUBE_MUSIC_CLIENT_ID=
